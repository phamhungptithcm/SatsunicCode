# Public Firebase web config only. Never add Admin, Gemini or OAuth client secrets.
# Dev stays on local demo emulators unless production is explicitly selected.
VITE_FIREBASE_ENV=emulator
# Production config lives in ignored apps/web/.env.production.local.
# Production project ID is fixed to satsuniccode in firebase.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_GOOGLE_CLIENT_ID=
