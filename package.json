{
  "name": "satsuniccode",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "functions"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w functions",
    "typecheck": "tsc --noEmit && npm run typecheck -w functions",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-satsuniccode --only auth,firestore,database,storage,functions",
    "test:rules": "firebase emulators:exec --project demo-satsuniccode --only auth,firestore,database,storage 'vitest run --config vitest.rules.config.ts'",
    "test:e2e": "playwright test",
    "seed": "node scripts/seed.mjs",
    "verify:local": "npm run typecheck && npm test && npm run build",
    "verify": "npm run verify:local && npm run test:rules && npm run test:e2e && node scripts/release-gate.mjs",
    "dev:google": "npm run dev:google -w apps/web"
  },
  "dependencies": {
    "yjs": "13.6.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "14.27.0",
    "node": "22.22.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "type": "module"
}
